# Скопируйте в .env и впишите ключ. Файл .env в git не попадает.

# Провайдер по умолчанию: gemini | ollama | none (none = только проверки без LLM)
RAVEL_PROVIDER=gemini

# Google Gemini (бесплатный ключ: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Актуальное имя модели смотрите в AI Studio
GEMINI_MODEL=gemini-3.8-flash
# Запасные модели через запятую: на них агент переходит, если основная перегружена (503 «high demand»)
# или исчерпала свою бесплатную квоту. Пустое значение отключает переход.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Локальный режим через Ollama (https://ollama.com), документ не покидает машину
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Кэш ответов LLM (повторный прогон даёт тот же отчёт и не тратит квоту)
RAVEL_CACHE_DIR=.cache/llm
